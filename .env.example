# Bus OS Vault — Variáveis de Ambiente
# Obtenha sua chave gratuita em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Provedor LLM para síntese: "gemini" ou "openrouter"
LLM_PROVIDER=openrouter
# Chave gratuita: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Modelos gratuitos terminam em ":free" (ex: nvidia/nemotron-3-super-120b-a12b:free)
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
DEBUG=false

# URL pública via Cloudflare Quick Tunnel (sem admin/firewall).
# Requer cloudflared no PATH ou em %TEMP%\cloudflared.exe (instalação portátil, sem admin).
# Provedores: "auto" (cloudflare → localtunnel), "cloudflare", "localtunnel".
# Requer node.js no PATH para localtunnel; binário local instalado em %TEMP%\bus-os-lt\.
TUNNEL_ENABLED=false
TUNNEL_PROVIDER=auto
